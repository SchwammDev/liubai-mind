{
  "task": "accumulate_grid should support an alternative way of summarizing each cell's observations. Callers may specify a mode: \"mean\" keeps today's per-cell averaging, and a new \"max\" mode reports the highest observed value in each cell instead of the average. An unrecognized mode is a validation error. When mode is omitted, behavior is exactly what it is today. The mode does not affect which observations are dropped, rejected, or saturated, only how a filled cell's value is computed. Keep accumulate_grid's signature and every existing behavior unchanged.",
  "probes": [
    {
      "args": [{
        "grid": { "width": 1, "height": 1, "cell_size": 10 },
        "observations": [
          { "x": 0, "y": 0, "value": 10, "quality": 80 },
          { "x": 1, "y": 1, "value": 50, "quality": 90 },
          { "x": 2, "y": 2, "value": 5, "quality": 70 }
        ],
        "fill_value": 0,
        "mode": "max"
      }],
      "returns": {
        "ok": true,
        "cells": [[50]],
        "flags": [["good"]],
        "dropped": 0,
        "rejected": 0,
        "saturated": 0,
        "coverage": 100,
        "line": "cells=1;filled=1;dropped=0;rejected=0;saturated=0;coverage=100"
      }
    },
    {
      "args": [{
        "grid": { "width": 2, "height": 1, "cell_size": 10 },
        "observations": [{ "x": 1, "y": 0, "value": 7, "quality": 80 }],
        "fill_value": -1,
        "mode": "max"
      }],
      "returns": {
        "ok": true,
        "cells": [[7, -1]],
        "flags": [["good", "empty"]],
        "dropped": 0,
        "rejected": 0,
        "saturated": 0,
        "coverage": 50,
        "line": "cells=2;filled=1;dropped=0;rejected=0;saturated=0;coverage=50"
      }
    },
    {
      "args": [{
        "grid": { "width": 1, "height": 1, "cell_size": 10 },
        "observations": [],
        "fill_value": 0,
        "mode": "sum"
      }],
      "returns": { "ok": false, "error": "bad mode" }
    },
    {
      "args": [{
        "grid": { "width": 1, "height": 1, "cell_size": 10 },
        "observations": [],
        "fill_value": 0,
        "mode": 5
      }],
      "returns": { "ok": false, "error": "bad mode" }
    }
  ]
}
