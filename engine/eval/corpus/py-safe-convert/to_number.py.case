from __future__ import annotations


def to_number(text: str) -> float | None:
    if not isinstance(text, str):
        return None

    stripped = text.strip()
    if len(stripped) == 0:
        return None

    sign = ""
    body = stripped
    if body[0] == "+" or body[0] == "-":
        sign = body[0]
        body = body[1:]

    if len(body) == 0:
        return None

    if body.count(".") > 1:
        return None

    if "." in body:
        whole, _, frac = body.partition(".")
        if len(whole) == 0 or len(frac) == 0:
            return None
        if not whole.isdigit() or not frac.isdigit():
            return None
    else:
        if not body.isdigit():
            return None

    return float(sign + body)
