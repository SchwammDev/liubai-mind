from __future__ import annotations


def password_strength(pw: str) -> int:
    score = 0

    if len(pw) >= 8:
        score += 1
    elif len(pw) < 4:
        score -= 1

    has_lower = any(ch.islower() for ch in pw)
    has_upper = any(ch.isupper() for ch in pw)
    has_digit = any(ch.isdigit() for ch in pw)
    has_symbol = any(not ch.isalnum() for ch in pw)

    if has_lower:
        score += 1
    if has_upper:
        score += 1
    if has_digit:
        score += 1
    if has_symbol:
        score += 1

    repeats = 0
    for i in range(1, len(pw)):
        if pw[i] == pw[i - 1]:
            repeats += 1

    if repeats >= 3:
        score -= 2
    elif repeats >= 1:
        score -= 1

    if len(pw) >= 12 and has_symbol:
        score += 1

    if score < 0:
        score = 0

    return score
