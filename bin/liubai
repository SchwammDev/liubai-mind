#!/usr/bin/env bash
# Daily driver: the pinned pi engine + steering rails, runnable from any working
# directory. Rails load from the copy setup.sh installs into ~/.pi/agent/extensions;
# the provider and model come from pi's own settings.json (~/.pi/agent/). Run
# `setup.sh` once before first use, and again to promote rails changes.
#
# Steering is on by default. For the un-steered baseline: LIUBAI_RAILS_OFF=1 liubai ...
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PI_BIN="$REPO/node_modules/.bin/pi"
PI_PKG="@earendil-works/pi-coding-agent"

command -v mise >/dev/null 2>&1 || { echo "liubai: mise not found — run $REPO/setup.sh" >&2; exit 1; }

# `liubai update [version]` bumps the pinned engine and reinstalls. This is the
# only safe update for a pinned+vendored engine: it rewrites the exact pin in
# package.json and package-lock.json (both tracked), so the change lands in git.
# Pi's own `pi update` would reinstall in place and silently drift off the pin.
if [ "${1:-}" = "update" ]; then
  target="${2:-latest}"
  mise exec -- npm install --prefix "$REPO" --save-exact "$PI_PKG@$target"
  echo "liubai: engine updated. Review and commit package.json + package-lock.json."
  exit 0
fi

# `liubai cc-hook` runs the Claude Code PreToolUse adapter from the installed
# engine copy. Installed by setup.sh into ~/.claude/settings.json as a global
# PreToolUse hook. Cold-subprocess latency tracked in #25.
if [ "${1:-}" = "cc-hook" ]; then
  shift
  exec mise exec -- node --experimental-strip-types "$HOME/.pi/agent/engine/cc-hook.ts" "$@"
fi

# `liubai crap` runs the CRAP gate against staged TS files using the coverage
# snapshot in the caller's working directory (coverage/snapshot.json, produced
# by run-tests.sh). Intended as a pre-commit hook; run from the repo root.
if [ "${1:-}" = "crap" ]; then
  exec mise exec -- node --experimental-strip-types "$REPO/engine/crap-cli.ts"
fi

[ -x "$PI_BIN" ] || { echo "liubai: engine not installed — run $REPO/setup.sh" >&2; exit 1; }

# `liubai --dev` steers the session from the working tree instead of the installed
# copy, using pi's own dev seam. `--no-extensions` also drops every other globally
# discovered extension, and spawned children still load the installed copy, so the
# seam covers the parent session only.
if [ "${1:-}" = "--dev" ]; then
  shift
  exec mise exec -- "$PI_BIN" --no-extensions \
    -e "$REPO/extensions/rails" -e "$REPO/extensions/subagent" "$@"
fi

INSTALLED_RAILS="$HOME/.pi/agent/extensions/rails"
if [ ! -d "$INSTALLED_RAILS" ] || [ -L "$INSTALLED_RAILS" ]; then
  echo "liubai: steering rails are not installed — run $REPO/setup.sh" >&2
fi

exec mise exec -- "$PI_BIN" "$@"
